        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Set seed for reproducibility\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate 200 unique user IDs\n",
        "user_ids = [f\"USR_{i:03d}\" for i in range(1, 201)]\n",
        "\n",
        "# Generate 1000 records by randomly assigning them to these 200 users\n",
        "records_user_ids = np.random.choice(user_ids, size=1000, replace=True)\n",
        "\n",
        "# Generate loan details\n",
        "loan_amounts = np.random.choice([5000, 10000, 15000, 20000, 25000, 30000, 50000], size=1000, p=[0.1, 0.2, 0.2, 0.2, 0.15, 0.1, 0.05])\n",
        "credit_scores = np.random.randint(300, 851, size=1000)\n",
        "annual_incomes = np.random.randint(24000, 150001, size=1000)\n",
        "loan_terms = np.random.choice([12, 24, 36, 60], size=1000, p=[0.1, 0.3, 0.4, 0.2])\n",
        "\n",
        "# Determine loan status based on simple logical criteria (simulating approval logic)\n",
        "# If credit score is > 650 and debt-to-income (implicitly represented by income vs loan amount) is reasonable\n",
        "loan_statuses = []\n",
        "for cs, income, amount in zip(credit_scores, annual_incomes, loan_amounts):\n",
        "    # Simple heuristic for approval\n",
        "    if cs >= 660 and (income / 12) > (amount / 24):\n",
        "        status = \"Approved\"\n",
        "    elif cs >= 580 and (income / 12) > (amount / 12) and np.random.rand() > 0.4:\n",
        "        status = \"Approved\"\n",
        "    else:\n",
        "        status = \"Rejected\"\n",
        "    loan_statuses.append(status)\n",
        "\n",
        "# Create DataFrame\n",
        "df_loans = pd.DataFrame({\n",
        "    'User_ID': records_user_ids,\n",
        "    'Loan_Amount_USD': loan_amounts,\n",
        "    'Credit_Score': credit_scores,\n",
        "    'Annual_Income_USD': annual_incomes,\n",
        "    'Loan_Term_Months': loan_terms,\n",
        "    'Loan_Status': loan_statuses\n",
        "})\n",
        "\n",
        "# Display summary and the first few rows\n",
        "print(f\"Dataset Shape: {df_loans.shape}\")\n",
        "print(f\"Unique Users: {df_loans['User_ID'].nunique()}\")\n",
        "display(df_loans.head(10))"
      ],
