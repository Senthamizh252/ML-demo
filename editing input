      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Calculate training accuracy, testing accuracy, and remaining error rates\n",
        "train_acc = model.score(X_train_scaled, y_train)\n",
        "test_acc = model.score(X_test_scaled, y_test)\n",
        "\n",
        "# Prepare data representing model generalization vs gap (overfitting risk / variance indicator)\n",
        "labels = ['Generalization Performance (Test Score)', 'Underfitting Error (Bias)', 'Overfitting Gap (Variance Indicator)']\n",
        "\n",
        "# Compute sizes:\n",
        "# - Test accuracy represents the secure performance that generalizes.\n",
        "# - 1.0 - Train accuracy represents what the model failed to learn (Bias).\n",
        "# - Train accuracy - Test accuracy represents the drop from train to test (Variance / Overfitting gap).\n",
        "bias_error = 1.0 - train_acc\n",
        "variance_gap = max(0.0, train_acc - test_acc)\n",
        "general_score = test_acc\n",
        "\n",
        "sizes = [general_score, bias_error, variance_gap]\n",
        "colors = ['#4CAF50', '#FF5722', '#FFC107']\n",
        "explode = (0, 0.1, 0.1)  # highlight bias and variance indicators\n",
        "\n",
        "# 2. Plot the Pie Chart\n",
        "plt.figure(figsize=(8, 8))\n",
        "plt.pie(\n",
