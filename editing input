        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import classification_report, accuracy_score\n",
        "\n",
        "# 1. Feature Engineering\n",
        "df_features = df_loans.copy()\n",
        "\n",
        "# Create extra features\n",
        "df_features['Monthly_Income'] = df_features['Annual_Income_USD'] / 12\n",
        "df_features['Estimated_Monthly_Payment'] = df_features['Loan_Amount_USD'] / df_features['Loan_Term_Months']\n",
        "df_features['Debt_to_Income_Ratio'] = df_features['Estimated_Monthly_Payment'] / (df_features['Monthly_Income'] + 1e-5)\n",
        "df_features['Loan_to_Income_Ratio'] = df_features['Loan_Amount_USD'] / df_features['Annual_Income_USD']\n",
        "\n",
        "print(\"New Features Created!\")\n",
        "display(df_features[['User_ID', 'Loan_Amount_USD', 'Annual_Income_USD', 'Debt_to_Income_Ratio', 'Loan_to_Income_Ratio']].head())\n",
        "\n",
        "# 2. Prepare Features and Target\n",
