        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(f\"Training Accuracy: {train_acc:.4%}\")\n",
        "print(f\"Testing Accuracy:  {test_acc:.4%}\")\n",
        "print(f\"Generalization Gap (Variance indicator): {variance_gap:.4%}\")"
